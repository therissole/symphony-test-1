model
  schema 1.1

type user

type system
  relations
    define superuser: [user]
    define standard_user: [user]
    define can_read_catalog: superuser or standard_user
    define can_manage_catalog: superuser
    define can_create_language: superuser
    define can_create_greeting: superuser

type language
  relations
    define system: [system]
    define can_view: can_read_catalog from system
    define can_update: can_manage_catalog from system
    define can_delete: can_manage_catalog from system

type greeting
  relations
    define system: [system]
    define can_view: can_read_catalog from system
    define can_update: can_manage_catalog from system
    define can_delete: can_manage_catalog from system
