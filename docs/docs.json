{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "ASP.NET Core Vertical Slice Reference",
  "colors": {
    "primary": "#0D9373",
    "light": "#07C983",
    "dark": "#0D9373"
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": false
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "required",
      "prefill": true,
      "autogenerate": true
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "architecture",
              "atdd-approach"
            ]
          },
          {
            "group": "Features",
            "pages": [
              "features/authentication",
              "features/languages",
              "features/greetings"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Endpoints",
            "openapi": {
              "source": ".generated/openapi.json",
              "directory": "api-reference/endpoints"
            }
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "icon": "github",
          "href": "https://github.com/therissole/symphony-test-1"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/therissole/symphony-test-1"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "/introduction"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/therissole/symphony-test-1"
    }
  }
}
