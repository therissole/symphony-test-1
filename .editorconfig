root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,razor}]
indent_size = 4
tab_width = 4

dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

dotnet_style_namespace_match_folder = true:error
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion
dotnet_style_readonly_field = true:suggestion

csharp_style_namespace_declarations = file_scoped:error
csharp_style_prefer_primary_constructors = false:silent
csharp_style_prefer_utf8_string_literals = true:suggestion
csharp_prefer_braces = true:suggestion

dotnet_diagnostic.IDE0130.severity = error
dotnet_diagnostic.IDE0160.severity = error

dotnet_naming_rule.interfaces_begin_with_i.severity = error
dotnet_naming_rule.interfaces_begin_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_begin_with_i.style = prefix_interface

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_interface.required_prefix = I
dotnet_naming_style.prefix_interface.capitalization = pascal_case

[*.{csproj,props,targets,slnx,xml}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[tests/**/*.cs]
# Scenario-style test names intentionally use underscores for readability.
dotnet_diagnostic.CA1707.severity = none

# Test doubles and protocol drivers deliberately use their abstractions.
dotnet_diagnostic.CA1859.severity = none

# One-off test setup values do not benefit from static array caching.
dotnet_diagnostic.CA1861.severity = none
