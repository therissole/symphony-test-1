<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SymphonyTest1.OpenFgaProvisioning</AssemblyName>
    <RootNamespace>SymphonyTest1.OpenFgaProvisioning</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenFga.Sdk" Version="0.10.4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\openfga\authorization-model.json"
          Link="OpenFga\authorization-model.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
