@inject HttpClient Http

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.body1">
                Delete <strong>“@GreetingText”</strong>?
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                This action cannot be undone.
            </MudText>
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_deleting">Cancel</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled"
                   OnClick="DeleteAsync" Disabled="_deleting"
                   data-testid="confirm-delete-greeting">
            @if (_deleting)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
            }
            Delete
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired]
    public Guid Id { get; set; }

    [Parameter, EditorRequired]
    public string GreetingText { get; set; } = string.Empty;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private bool _deleting;
    private string? _error;

    private async Task DeleteAsync()
    {
        BrowserTelemetry.NameCurrentAction("Delete greeting confirmed");

        _deleting = true;
        _error = null;

        try
        {
            using var response = await Http.DeleteAsync($"api/greetings/{Id}");
            if (!response.IsSuccessStatusCode)
            {
                _error = response.StatusCode == System.Net.HttpStatusCode.NotFound
                    ? "This greeting no longer exists. Refresh the list."
                    : (await ApiProblemReader.ReadAsync(response, CancellationToken.None)).Message;
                return;
            }

            MudDialog.Close(DialogResult.Ok(Id));
        }
        catch (HttpRequestException)
        {
            _error = "The greeting could not be deleted. Check the API connection and try again.";
        }
        finally
        {
            _deleting = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
