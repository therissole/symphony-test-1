@inject HttpClient Http

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudStack Spacing="3">
                <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true">
                    Codes should be short, stable identifiers such as <strong>en</strong> or
                    <strong>en-AU</strong>.
                </MudAlert>
                @if (_generalError is not null)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                        @_generalError
                    </MudAlert>
                }
                <MudTextField @bind-Value="_name"
                              Label="Name"
                              Required="true"
                              RequiredError="Name is required."
                              MaxLength="100"
                              Counter="100"
                              Error="@(_nameError is not null)"
                              ErrorText="@_nameError"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              data-testid="language-name" />
                <MudTextField @bind-Value="_code"
                              Label="Code"
                              Required="true"
                              RequiredError="Code is required."
                              MaxLength="10"
                              Counter="10"
                              Error="@(_codeError is not null)"
                              ErrorText="@_codeError"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              data-testid="language-code" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_saving">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="SaveAsync" Disabled="_saving"
                   data-testid="save-language">
            @if (_saving)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
            }
            Create
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm? _form;
    private string _name = string.Empty;
    private string _code = string.Empty;
    private bool _saving;
    private string? _nameError;
    private string? _codeError;
    private string? _generalError;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private async Task SaveAsync()
    {
        BrowserTelemetry.NameCurrentAction("Create language clicked");

        await _form!.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _saving = true;
        ClearErrors();

        try
        {
            var request = new Request(_name.Trim(), _code.Trim());
            using var response = await Http.PostAsJsonAsync("api/languages/", request);

            if (!response.IsSuccessStatusCode)
            {
                ApplyProblem(await ApiProblemReader.ReadAsync(response, CancellationToken.None));
                return;
            }

            var created = await response.Content.ReadFromJsonAsync<Response>();
            MudDialog.Close(DialogResult.Ok(created?.Id));
        }
        catch (HttpRequestException)
        {
            _generalError = "The language could not be created. Check the API connection and try again.";
        }
        finally
        {
            _saving = false;
        }
    }

    private void ApplyProblem(ApiProblem problem)
    {
        _nameError = problem.GetFieldError("name");
        _codeError = problem.GetFieldError("code");
        _generalError = _nameError is null && _codeError is null ? problem.Message : null;
    }

    private void ClearErrors() => (_nameError, _codeError, _generalError) = (null, null, null);

    private void Cancel() => MudDialog.Cancel();

    private sealed record Request(string Name, string Code);

    private sealed record Response(
        Guid Id,
        string Name,
        string Code,
        DateTimeOffset CreatedAt,
        DateTimeOffset UpdatedAt);
}
